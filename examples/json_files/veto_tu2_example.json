{
    "name": "veto_proc",
    "input_dir": "../examples/daq_files/TU2/",
    "runs": ["run390"],
    "output_dir": "../examples/output_files/",
    "processing_setup": {
        "keep_saturation": true,
        "keep_pileup": true,
        "get_timediff": true,
        "apply_veto": true,
        "calibrate_detectors": false
    },
    "main_detectors": [
        {"name": "TU2",
         "board": 0,
         "channel": 0
        } 
    ],
    "veto_time_window_mus": 2,
    "veto_detectors": [
        {   "name": "Sz1",
            "channel": 2,
            "adc_threshold": 1000
        },
        {   "name": "Sz2",
            "channel": 3,
            "adc_threshold": 1000
        },
        {   "name": "Sz3",
            "channel": 5,
            "adc_threshold": 1000
        },
        {   "name": "Sz4",
            "channel": 6,
            "adc_threshold": 1000
        }
    ]
}